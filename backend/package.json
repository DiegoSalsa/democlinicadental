{
  "name": "dental-backend",
  "version": "1.0.0",
  "description": "Backend API para Demo Clínica Dental",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node --esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "npm run build && node dist/scripts/init-db.js",
    "db:seed": "npm run build && node dist/scripts/seed.js",
    "db:status": "npm run build && node dist/scripts/db-status.js",
    "db:objects": "npm run build && node dist/scripts/db-objects.js",
    "db:setup": "npm run db:init && npm run db:seed"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "type": "module"
}
